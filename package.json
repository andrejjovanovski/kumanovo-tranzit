{
  "name": "kumanovo-transit",
  "private": true,
  "version": "0.1.0",
  "description": "Kumanovo Transit — rider-facing public transit app (monorepo)",
  "packageManager": "pnpm@10.16.1",
  "scripts": {
    "dev": "pnpm --filter @kt/web dev",
    "build": "pnpm --filter @kt/web build",
    "preview": "pnpm --filter @kt/web preview",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r --if-present lint"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
